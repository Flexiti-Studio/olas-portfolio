generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Application {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_title        String
  company          String
  location         String?
  job_url          String?
  job_description  String?
  source           String?
  salary_min       Int?
  salary_max       Int?
  salary_currency  String?      @default("USD")
  stage            String?      @default("Wishlist")
  tags             String[]     @default([])
  linked_cv_id     String?      @db.Uuid
  linked_cv_slug   String?
  cover_letter_url   String?
  date_applied       DateTime?
  follow_up_date     DateTime?
  notes              String?
  timeline           Json[]       @default([])
  interviews         Json[]       @default([])
  offer              Json?
  stage_history      Json[]       @default([])
  company_research_id String?
  created_at         DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?    @default(now()) @db.Timestamptz(6)

  CoverLetter        CoverLetter[]
  companyResearch    CompanyResearch[]
  courses            Course[]
  goals              Goal[]
  
  @@map("applications")
}

model CoverLetter {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id      String?      @db.Uuid
  linked_cv_id        String?      @db.Uuid
  linked_cv_slug      String?
  company             String
  job_title           String
  job_description     String?
  hiring_manager      String?
  tone                String?
  length              String?
  custom_instructions String?
  slug                String?      @unique
  versions            Json[]       @default([])
  current_version     Int?         @default(0)
  status              String?      @default("draft")
  created_at          DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?    @default(now()) @db.Timestamptz(6)

  application         Application? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  
  @@map("cover_letters")
}

model Template {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  raw_text     String?
  pdf_url      String?
  sections     Json?       @default("{}")
  is_default   Boolean     @default(false)
  created_at   DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?   @default(now()) @db.Timestamptz(6)

  CvRecord     CvRecord[]

  @@map("templates")
}

model CvRecord {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String       @unique
  job_title        String
  company          String
  job_description  String?
  instructions     String?
  tone             String?
  template_id      String?      @db.Uuid
  versions         Json[]       @default([])
  current_version  Int?         @default(0)
  status           String?      @default("draft")
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?    @default(now()) @db.Timestamptz(6)

  template         Template?    @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@map("cv_records")
}

model Setting {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String      @unique
  value      Json
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at DateTime?   @default(now()) @db.Timestamptz(6)

  @@map("settings")
}

model CompanyResearch {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company         String
  role            String?
  depth           String?      @default("standard")
  snapshot        Json?
  tech_stack      Json?
  culture         Json?
  news            Json?
  interview_intel Json?
  talking_points  Json?
  competitors     Json?
  sources         Json?
  raw_search_data Json?
  application_id  String?      @db.Uuid
  application     Application? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)

  @@index([company])
  @@index([application_id])
  @@map("company_research")
}

model Course {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  description       String?
  source_type       String          @default("text")
  source_text       String?
  focus_areas       String[]        @default([])
  depth             String          @default("standard")
  estimated_duration String?
  application_id    String?         @db.Uuid
  application       Application?    @relation(fields: [application_id], references: [id], onDelete: SetNull)
  modules           CourseModule[]
  progress          CourseProgress?
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @default(now()) @db.Timestamptz(6)

  @@index([application_id])
  @@map("courses")
}

model CourseModule {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id   String      @db.Uuid
  course      Course      @relation(fields: [course_id], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  lessons     Lesson[]
  quiz        Quiz?
  flashcards  Flashcard[]
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)

  @@index([course_id])
  @@map("course_modules")
}

model Lesson {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id         String       @db.Uuid
  module            CourseModule @relation(fields: [module_id], references: [id], onDelete: Cascade)
  title             String
  order             Int
  estimated_minutes Int          @default(5)
  content           Json
  completed         Boolean      @default(false)
  completed_at      DateTime?
  created_at        DateTime?    @default(now()) @db.Timestamptz(6)

  @@index([module_id])
  @@map("lessons")
}

model Quiz {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id  String        @unique @db.Uuid
  module     CourseModule  @relation(fields: [module_id], references: [id], onDelete: Cascade)
  questions  Json
  attempts   QuizAttempt[]
  created_at DateTime?     @default(now()) @db.Timestamptz(6)

  @@map("quizzes")
}

model QuizAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id      String   @db.Uuid
  quiz         Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  answers      Json
  score        Int
  passed       Boolean
  completed_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([quiz_id])
  @@map("quiz_attempts")
}

model Flashcard {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id  String            @db.Uuid
  module     CourseModule      @relation(fields: [module_id], references: [id], onDelete: Cascade)
  front      String
  back       String
  ratings    FlashcardRating[]
  created_at DateTime?         @default(now()) @db.Timestamptz(6)

  @@index([module_id])
  @@map("flashcards")
}

model FlashcardRating {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flashcard_id String    @db.Uuid
  flashcard    Flashcard @relation(fields: [flashcard_id], references: [id], onDelete: Cascade)
  rating       String
  rated_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([flashcard_id])
  @@map("flashcard_ratings")
}

model CourseProgress {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id           String   @unique @db.Uuid
  course              Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  completed_lessons   String[]
  current_module_id   String?
  current_lesson_id   String?
  overall_percentage  Int      @default(0)
  flashcard_mastery   Int      @default(0)
  flashcard_history   Json[]   @default([])
  quiz_average        Int      @default(0)
  assessment_history  Json[]   @default([])
  last_studied_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  @@map("course_progress")
}

model TaskProfile {
  id             String   @id @default("task-profile")
  personal_info  Json     @default("{}")
  experience     Json[]   @default([])
  projects       Json[]   @default([])
  skills         Json[]   @default([])
  education      Json[]   @default([])
  certifications Json[]   @default([])
  base_prompt    String?
}

model TaskApplication {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_description    String
  cv_content         Json
  cover_letter       String
  job_url            String?
  screenshot_url     String?
  status             String   @default("Applied")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
}

model TaskSessionCounter {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date         String    @unique // Format: YYYY-MM-DD
  sessionCount Int       @default(1)
  linkCount    Int       @default(0)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@map("task_session_counters")
}

model TaskLinkRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  date       String   // Format: YYYY-MM-DD
  created_at DateTime @default(now()) @db.Timestamptz(6)
  
  @@map("task_link_records")
}

model TaskPaymentSetting {
  id             String   @id @default("default")
  cost_per_link  Float    @default(50)
  weekly_target  Float    @default(10000)
  session_target Int      @default(20)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("task_payment_settings")
}

model TaskWeeklyTarget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_start String   @unique
  target     Float
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("task_weekly_targets")
}

// -----------------------------------------------------------------------------
// BUDGETING (PHASE 1)
// -----------------------------------------------------------------------------

model BankAccount {
  id            String        @id @default(cuid())
  name          String        @unique // e.g. "GTBank", "Opay", "Cash"
  balance       Decimal       @default(0) // running ledger balance, source of truth
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  incomes       Income[]
  subcategories Subcategory[]
  transfersOut  Transfer[]    @relation("TransferFrom")
  transfersIn   Transfer[]    @relation("TransferTo")
  transactions  Transaction[]
}

model IncomeCategory {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "xoxo", "Day Job", "Qefas Pallative"
  createdAt DateTime @default(now())

  incomes   Income[]
}

model Income {
  id               String         @id @default(cuid())
  amount           Decimal
  description      String?
  incomeCategoryId String
  incomeCategory   IncomeCategory @relation(fields: [incomeCategoryId], references: [id])
  bankAccountId    String?
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id])
  isRecurring      Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

model Transfer {
  id             String      @id @default(cuid())
  amount         Decimal
  note           String?
  fromAccountId  String
  fromAccount    BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId    String
  toAccount      BankAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  createdAt      DateTime    @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String        // "Needs" | "Wants" | "Savings & Investments"
  group         BudgetGroup
  subcategories Subcategory[]
}

enum BudgetGroup {
  NEEDS
  WANTS
  SAVINGS
}

model Subcategory {
  id            String        @id @default(cuid())
  name          String        // "Groceries", "Emergency Fund", etc.
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  goals         BudgetGoal[]
  transactions  Transaction[]
}

model BudgetGoal {
  id            String      @id @default(cuid())
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])
  amount        Decimal
  percentage    Decimal?
  periodId      String
  period        Period      @relation(fields: [periodId], references: [id])
  createdAt     DateTime    @default(now())
}

model Transaction {
  id            String      @id @default(cuid())
  amount        Decimal
  rawText       String?
  source        String      @default("telegram")
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdAt     DateTime    @default(now())
}

model Goal {
  id             String    @id @default(cuid())
  title          String    // e.g. "Save ₦500,000 for new laptop"
  targetAmount   Decimal?
  currentAmount  Decimal?  @default(0)
  deadline       DateTime?
  aiGenerated    Boolean   @default(false)
  status         String    @default("active") // active | achieved | abandoned
  subcategoryId  String?
  timeline       Json?     @default("[]") // [{ id: string, text: string, completed: boolean }]
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  
  application_id String?      @db.Uuid
  application    Application? @relation(fields: [application_id], references: [id], onDelete: Cascade)
}

model Period {
  id            String       @id @default(cuid())
  label         String       // e.g. "2/3/2027" or "Mar 2027" — display only
  startDate     DateTime     @default(now())
  rolloverAmount Decimal     @default(0)
  createdAt     DateTime     @default(now())
  goals         BudgetGoal[]
}

model AppConfig {
  id              String @id @default("singleton")
  activePeriodId  String
}

// -----------------------------------------------------------------------------
// FOCUS MODE (PHASE 7)
// -----------------------------------------------------------------------------

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE | DONE | PAUSED | ARCHIVED
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  tasks       Task[]
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  done        Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model FocusState {
  id               String   @id @default("singleton")
  focusedProjectId String?
  updatedAt        DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// KNOWLEDGE (PHASE 8)
// -----------------------------------------------------------------------------

model KnowledgeEntry {
  id           String    @id @default(cuid())
  type         String    // "IDEA" | "KNOWLEDGE"
  content      String    // current/latest text
  summary      String?   // optional short summary for quick scanning in the dashboard
  tags         String[]  @default([])
  projectId    String?   // optional — link to a Project from the focus tracker
  vectorId     String    // Pinecone vector id, same as this row's id for simplicity
  source       String    @default("telegram") // telegram_text | telegram_voice | telegram_photo | dashboard
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  versions     KnowledgeEntryVersion[]
}

model KnowledgeEntryVersion {
  id        String         @id @default(cuid())
  entryId   String
  entry     KnowledgeEntry @relation(fields: [entryId], references: [id])
  content   String         // snapshot of content before this version's edit
  createdAt DateTime       @default(now())
}

// -----------------------------------------------------------------------------
// CREATORS MANAGER
// -----------------------------------------------------------------------------

model CreatorProject {
  id        String   @id @default(cuid())
  name      String
  client    String?
  creator   String
  status    String   @default("Planning") // Planning, In Progress, Review, Completed
  budget    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeline  Json?    @default("[]")
  titles    Json?    @default("[]")
  contents  Json?    @default("[]")
  videos    Json?    @default("[]")
}

// -----------------------------------------------------------------------------
// CAREER
// -----------------------------------------------------------------------------

model Career {
  id          String   @id @default(cuid())
  title       String
  category    String   // e.g., "Goal", "Milestone", "Achievement", "Skill"
  status      String   @default("Planned") // e.g., "Planned", "In Progress", "Achieved"
  date        String?
  description String?
  skills      Json?    @default("[]") // [{ name: "React", status: "have" | "need" | "progress" }]
  education   Json?    @default("[]") // [{ name: "BSc Computer Science", status: "have" | "need" | "progress" }]
  certifications Json? @default("[]") // [{ name: "AWS Certified Developer", status: "have" | "need" | "progress" }]
  timeline    Json?    @default("[]") // [{ title: "Started learning", date: "2023", status: "completed" }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("careers")
}

model SocialTemplate {
  id          String   @id @default(cuid())
  platform    String   // "youtube" | "tiktok" | "instagram" | "twitter" | "linkedin"
  name        String
  description String?
  body        String
  placeholders Json?    @default("[]")
  is_primary  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("social_templates")
}

// -----------------------------------------------------------------------------
// DESKTOP WIDGET RELEASES
// -----------------------------------------------------------------------------

model WidgetRelease {
  id          String   @id @default(cuid())
  version     String   @unique
  notes       String?
  pubDate     DateTime @default(now())
  signature   String?
  downloadUrl String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("widget_releases")
}

model FinancialHistory {
  id             String    @id @default(cuid())
  date           DateTime  @default(now())
  netWorth       Decimal
  monthlyIncome  Decimal

  @@map("financial_history")
}
